# ---------- Model backend ----------
# anthropic | openai_compat   (shorthands: ollama, vllm, openrouter)
DEVFLOW_PROVIDER=anthropic
# Omit to take the provider's default (claude-opus-5 / qwen3:32b / ...)
DEVFLOW_MODEL=claude-opus-5
DEVFLOW_MAX_TOKENS=32000

# --- when DEVFLOW_PROVIDER=anthropic ---
ANTHROPIC_API_KEY=sk-ant-...
# low | medium | high | xhigh | max  (xhigh suits implement_ticket)
DEVFLOW_EFFORT=high

# --- when DEVFLOW_PROVIDER=openai_compat (any OpenAI-compatible server) ---
#   Ollama     http://localhost:11434/v1      vLLM       http://localhost:8000/v1
#   llama.cpp  http://localhost:8080/v1       LM Studio  http://localhost:1234/v1
#   OpenRouter https://openrouter.ai/api/v1   Together   https://api.together.xyz/v1
# DEVFLOW_BASE_URL=http://localhost:11434/v1
# DEVFLOW_API_KEY=                 # ignored by local runtimes
# DEVFLOW_TEMPERATURE=0.0

# ---------- Autonomy ----------
# supervised | semi | autonomous   (default: semi)
DEVFLOW_AUTONOMY=semi
DEVFLOW_MAX_ITERATIONS=25
DEVFLOW_MAX_TOOL_CALLS=60

# ---------- Backends ----------
# 1 = run entirely against the local mock store (no credentials needed)
DEVFLOW_MOCK=1
DEVFLOW_DATA_DIR=./data
DEVFLOW_WORKSPACE=./sandbox/demo-repo

# ---------- GitHub (live mode) ----------
GITHUB_TOKEN=
GITHUB_API=https://api.github.com

# ---------- Jira (live mode) ----------
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=

# ---------- Service ----------
DEVFLOW_HOST=0.0.0.0
DEVFLOW_PORT=8088
# Shared secret n8n sends as X-Devflow-Token
DEVFLOW_SERVICE_TOKEN=dev-local-token
# Where the orchestrator posts approval requests / run completions
N8N_APPROVAL_WEBHOOK=http://localhost:5678/webhook/devflow-approval-request
